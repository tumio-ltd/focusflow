{
  "$schema": "https://focusflow.io/schema/v1.json",
  "meta": {
    "title": "Minimal 2-Node Demo",
    "viewport": { "width": 1920, "height": 1080 }
  },
  "asset": {
    "url": "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1920' height='1080' viewBox='0 0 1920 1080'><rect width='1920' height='1080' fill='%230b0f19'/><rect x='300' y='380' width='400' height='260' rx='20' fill='%231e293b' stroke='%2338bdf8' stroke-width='4'/><text x='500' y='520' fill='%23f8fafc' font-size='32' text-anchor='middle' font-family='sans-serif'>Node A (Gateway)</text><rect x='1220' y='380' width='400' height='260' rx='20' fill='%231e293b' stroke='%2334d399' stroke-width='4'/><text x='1420' y='520' fill='%23f8fafc' font-size='32' text-anchor='middle' font-family='sans-serif'>Node B (Database)</text></svg>"
  },
  "elements": {
    "boxes": [
      {
        "id": "box-a",
        "type": "rect",
        "x": 300,
        "y": 380,
        "width": 400,
        "height": 260,
        "rx": 20,
        "style": { "stroke": "#38bdf8", "strokeWidth": 6, "glow": true }
      },
      {
        "id": "box-b",
        "type": "rect",
        "x": 1220,
        "y": 380,
        "width": 400,
        "height": 260,
        "rx": 20,
        "style": { "stroke": "#34d399", "strokeWidth": 6, "glow": true }
      }
    ],
    "paths": [
      {
        "id": "line-a-b",
        "from": "box-a.right",
        "to": "box-b.left",
        "style": { "stroke": "#fbbf24", "strokeWidth": 5, "mode": "stream" }
      }
    ]
  },
  "scenes": [
    {
      "id": "scene-0",
      "title": "Full Overview",
      "camera": { "zoom": 1.0, "x": 0, "y": 0, "duration": 1.0 },
      "activeElements": { "boxes": [], "paths": [], "callouts": [] }
    },
    {
      "id": "scene-1",
      "title": "Node A to Node B Flow",
      "camera": { "zoom": 1.4, "x": 0, "y": 0, "duration": 1.2 },
      "activeElements": {
        "boxes": ["box-a", "box-b"],
        "paths": ["line-a-b"],
        "callouts": [
          {
            "id": "co-a",
            "position": { "left": "25%", "top": "24%" },
            "theme": "blue",
            "title": "API Gateway",
            "desc": "Traffic Ingress & Routing"
          },
          {
            "id": "co-b",
            "position": { "left": "70%", "top": "24%" },
            "theme": "green",
            "title": "Data Tier",
            "desc": "Storage Cluster"
          }
        ]
      }
    }
  ]
}
