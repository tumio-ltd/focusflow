{
  "name": "@focusflow/studio",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:archive": "node -e \"const fs=require('fs');const ts=new Date().toISOString().replace(/[:.]/g,'-');if(fs.existsSync('playwright-report')){fs.cpSync('playwright-report','playwright-reports/report-'+ts,{recursive:true});console.log('Archived report to playwright-reports/report-'+ts);}\"",
    "test:cpu": "node scripts/measure-cpu.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@focusflow/dsl": "workspace:*",
    "@focusflow/player": "workspace:*",
    "clsx": "^2.1.1",
    "i18next": "^23.12.0",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "next-themes": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.1.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@focusflow/config-oxlint": "workspace:*",
    "@focusflow/config-tailwind": "workspace:*",
    "@focusflow/config-typescript": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^8.2.0"
  }
}
