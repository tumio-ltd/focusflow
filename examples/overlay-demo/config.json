{
  "$schema": "https://focusflow.io/schema/v1.json",
  "meta": {
    "title": "LuxeHMS Architecture - Dynamic Image Overlay & Deep-Dive Showcase",
    "viewport": {
      "width": 5120,
      "height": 2880
    },
    "theme": {
      "bg": "#0a0e17",
      "accent": "#38bdf8",
      "warn": "#f472b6",
      "green": "#34d399",
      "amber": "#fbbf24",
      "rose": "#fb7185"
    },
    "controls": {
      "autoplay": false,
      "interval": 4000,
      "showPlayBtn": true,
      "showCounter": true,
      "showProgress": true,
      "showHUDButton": true
    }
  },
  "asset": {
    "url": "./system_architecture.png"
  },
  "elements": {
    "boxes": [
      {
        "id": "box-postgres",
        "type": "rect",
        "x": 3636,
        "y": 628,
        "width": 1297,
        "height": 332,
        "rx": 18,
        "style": {
          "stroke": "#34d399",
          "strokeWidth": 6,
          "glow": true
        }
      },
      {
        "id": "box-redis",
        "type": "rect",
        "x": 3636,
        "y": 992,
        "width": 1297,
        "height": 260,
        "rx": 18,
        "style": {
          "stroke": "#fb7185",
          "strokeWidth": 6,
          "glow": true
        }
      },
      {
        "id": "box-auth-casl",
        "type": "rect",
        "x": 1664,
        "y": 840,
        "width": 886,
        "height": 160,
        "rx": 16,
        "style": {
          "stroke": "#f472b6",
          "strokeWidth": 6,
          "glow": true
        }
      }
    ],
    "paths": [],
    "dots": [],
    "images": [
      {
        "id": "img-tape-chart",
        "url": "./02_tape_chart_timeline_mockup.png",
        "x": 800,
        "y": 360,
        "width": 3520,
        "height": 1980,
        "style": {
          "borderRadius": 24,
          "boxShadow": true,
          "border": "3px solid rgba(56, 189, 248, 0.6)",
          "animation": "zoom-fade"
        }
      }
    ]
  },
  "scenes": [
    {
      "id": "scene-1",
      "title": "Overview",
      "camera": {
        "zoom": 1.0,
        "x": 0,
        "y": 0,
        "duration": 1.0
      },
      "activeElements": {
        "boxes": [],
        "paths": [],
        "dots": [],
        "images": [],
        "callouts": [
          {
            "id": "co-arch-overview",
            "position": {
              "left": "8%",
              "top": "12%"
            },
            "theme": "blue",
            "title": "LuxeHMS Cloud Topology",
            "desc": "Enterprise hotel management system · High concurrency microservice architecture"
          }
        ]
      }
    },
    {
      "id": "scene-2",
      "title": "Data & Cache",
      "camera": {
        "zoom": 1.45,
        "x": -13.0,
        "y": 5.0,
        "duration": 1.2
      },
      "activeElements": {
        "boxes": [
          "box-postgres",
          "box-redis"
        ],
        "paths": [],
        "dots": [],
        "images": [],
        "callouts": [
          {
            "id": "co-pg-cluster",
            "position": {
              "left": "45%",
              "top": "18%"
            },
            "theme": "green",
            "title": "PostgreSQL 16 High-Availability",
            "desc": "Primary-replica cluster · Streaming replication · 99.99% reliability"
          },
          {
            "id": "co-redis-cache",
            "position": {
              "left": "68%",
              "top": "46%"
            },
            "theme": "pink",
            "title": "Redis 7 High-Speed Cache",
            "desc": "In-memory rate limiting · Distributed session lock · Microsecond latency"
          }
        ]
      }
    },
    {
      "id": "scene-3",
      "title": "Live Timeline",
      "camera": {
        "zoom": 1.35,
        "x": 0,
        "y": 0,
        "duration": 1.2
      },
      "activeElements": {
        "boxes": [],
        "paths": [],
        "dots": [],
        "images": [
          "img-tape-chart"
        ],
        "callouts": [
          {
            "id": "co-timeline-deepdive",
            "position": {
              "left": "55%",
              "top": "55%"
            },
            "theme": "blue",
            "title": "Tape Chart Visual Timeline",
            "desc": "Real-time room occupancy grid · Drag-and-drop assignment · Live WebSocket sync"
          }
        ]
      }
    },
    {
      "id": "scene-4",
      "title": "CASL Auth",
      "camera": {
        "zoom": 1.5,
        "x": 20.0,
        "y": 10.0,
        "duration": 1.2
      },
      "activeElements": {
        "boxes": [
          "box-auth-casl"
        ],
        "paths": [],
        "dots": [],
        "images": [],
        "callouts": [
          {
            "id": "co-casl-auth",
            "position": {
              "left": "33%",
              "top": "35%"
            },
            "theme": "pink",
            "title": "CASL Role-Based Permissions",
            "desc": "Fine-grained ABAC/RBAC · Multi-tenant isolation · Dynamic ability factory"
          }
        ]
      }
    },
    {
      "id": "scene-5",
      "title": "Summary",
      "camera": {
        "zoom": 1.0,
        "x": 0,
        "y": 0,
        "duration": 1.2
      },
      "activeElements": {
        "boxes": [],
        "paths": [],
        "dots": [],
        "images": [],
        "callouts": [
          {
            "id": "co-final-summary",
            "position": {
              "left": "8%",
              "top": "12%"
            },
            "theme": "blue",
            "title": "System Topology Ready",
            "desc": "All 4 tiers synchronized · Ready for production deployment"
          }
        ]
      }
    }
  ]
}
