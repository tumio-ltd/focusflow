            "theme": "purple",
            "title": "60fps GPU Kinematics & Bezier Flows",
            "desc": "GPU-Composited Transforms · Traveling Neon Pulses",
            "titleI18n": {
              "en": "60fps GPU Kinematics & Bezier Flows",
              "zh": "60fps GPU 动力学与贝塞尔流光"
            },
            "descI18n": {
              "en": "GPU-Composited Transforms · Traveling Neon Pulses",
              "zh": "GPU 3D 合成变换 · 异步链路流动光脉冲"
            },
            "style": {
