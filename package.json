{
  "name": "focusflow-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Tumio Soft Technology Co., Ltd.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:studio": "turbo run dev --filter=@focusflow/studio",
    "dev:api": "turbo run dev --filter=@focusflow/api",
    "dev:worker": "turbo run dev --filter=@focusflow/render-worker",
    "dev:player": "vite",
    "build": "turbo run build",
    "build:standalone": "node scripts/build-standalone.js",
    "create:project": "node scripts/create-project.js",
    "db:migrate": "pnpm --filter=@focusflow/database prisma migrate dev",
    "db:studio": "pnpm --filter=@focusflow/database prisma studio",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish",
    "sync:models": "node scripts/sync-models.mjs",
    "sync:r2": "node scripts/sync-r2.mjs",
    "sync:r2:dry": "node scripts/sync-r2.mjs --dry-run",
    "sync:r2:all": "node scripts/sync-r2.mjs --all",
    "launch:pack": "node tooling/launch-ops/scripts/bundle-launch-pack.mjs",
    "launch:publish-ruanyf": "node tooling/launch-ops/scripts/publish-ruanyf.mjs",
    "launch:publish-ruanyf:dry": "node tooling/launch-ops/scripts/publish-ruanyf.mjs --dry-run",
    "launch:postiz": "node tooling/launch-ops/scripts/sync-to-postiz.mjs",
    "launch:postiz:dry": "node tooling/launch-ops/scripts/sync-to-postiz.mjs --dry-run",
    "launch:monitor-hn": "node tooling/launch-ops/scripts/monitor-hn.mjs",
    "launch:monitor-reddit": "node tooling/launch-ops/scripts/monitor-reddit.mjs",
    "launch:reply": "node tooling/launch-ops/scripts/reply-copilot.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@changesets/cli": "^2.27.0",
    "oxlint": "^0.15.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.0"
  },
  "packageManager": "pnpm@9.0.0"
}
